{
  "name": "sendmock-website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun scripts/sync-docs.ts && bun --bun next dev --port 5190",
    "build": "bun scripts/sync-docs.ts && bun --bun next build",
    "preview": "bunx --bun serve out -l 5191",
    "typecheck": "bun --bun tsc --noEmit",
    "lint": "bun --bun eslint .",
    "screenshots": "bun scripts/capture-screenshots.ts",
    "sync-docs": "bun scripts/sync-docs.ts",
    "examples": "bun scripts/write-examples.ts",
    "examples:check": "bun scripts/write-examples.ts --check",
    "test:e2e": "bun --bun playwright test",
    "test:unit": "bun test lib",
    "test:lighthouse": "bun test lighthouse"
  },
  "dependencies": {
    "@radix-ui/react-icons": "^1.3.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "fumadocs-core": "^16.17.8",
    "fumadocs-mdx": "^15.4.10",
    "fumadocs-ui": "^16.17.8",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "next": "^16.4.3",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
