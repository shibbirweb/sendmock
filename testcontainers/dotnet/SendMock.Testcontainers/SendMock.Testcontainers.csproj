<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>SendMock.Testcontainers</PackageId>
    <Version>0.0.0</Version>
    <Description>Starts SendMock in Docker from a test and gives its SMTP, HTTP and provider addresses.</Description>
    <PackageLicenseExpression>MIT OR Apache-2.0</PackageLicenseExpression>
    <Authors>MD. Shibbir Ahmed</Authors>
    <PackageProjectUrl>https://shibbirweb.github.io/sendmock/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/shibbirweb/sendmock</RepositoryUrl>
    <PackageTags>testcontainers;email;sms;smtp;testing</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Testcontainers" Version="4.16.0" />
  </ItemGroup>

</Project>
