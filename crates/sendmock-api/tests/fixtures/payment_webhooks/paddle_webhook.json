{
  "doc_url": "https://developer.paddle.com/webhooks/transactions/transaction-completed",
  "verified_on": "2026-11-05",
  "method": "POST",
  "content_type": "application/json",
  "documented_example": {
    "event_id": "evt_01h8bzakzx3hm2fmen703n5q45",
    "event_type": "transaction.completed",
    "occurred_at": "2023-08-21T11:57:47.390028Z",
    "notification_id": "ntf_01h8bzam1z32agrxjwhjgqk8w6",
    "data": {
      "id": "txn_01h8bxpvx398a7zbawb77y0kp5",
      "status": "completed",
      "origin": "web",
      "currency_code": "USD",
      "created_at": "2023-08-21T11:57:00.429437Z",
      "custom_data": null,
      "details": {
        "totals": {
          "total": "2400",
          "currency_code": "USD"
        }
      }
    }
  },
  "schema": {
    "type": "object",
    "required": [
      "event_id",
      "event_type",
      "occurred_at",
      "notification_id",
      "data"
    ],
    "properties": {
      "event_id": {
        "type": "string",
        "pattern": "^evt_[0-9a-z]{26}$"
      },
      "event_type": {
        "type": "string",
        "pattern": "^[a-z_]+(\\.[a-z_]+)+$"
      },
      "occurred_at": {
        "type": "string"
      },
      "notification_id": {
        "type": "string",
        "pattern": "^ntf_[0-9a-z]{26}$"
      },
      "data": {
        "type": "object",
        "required": [
          "id",
          "status",
          "origin",
          "currency_code",
          "created_at",
          "details"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "draft",
              "ready",
              "billed",
              "paid",
              "completed",
              "canceled",
              "past_due"
            ]
          },
          "currency_code": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "custom_data": {
            "type": [
              "object",
              "null"
            ]
          },
          "details": {
            "type": "object",
            "required": [
              "totals"
            ],
            "properties": {
              "totals": {
                "type": "object",
                "required": [
                  "total",
                  "currency_code"
                ],
                "properties": {
                  "total": {
                    "type": "string",
                    "pattern": "^[0-9]+$"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
