          "signature": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      },
      "event-data": {
        "type": "object",
        "required": ["event", "timestamp", "id", "recipient"],
        "properties": {
          "event": { "enum": ["accepted", "rejected", "delivered", "failed", "opened", "clicked", "unsubscribed", "complained", "stored"] },
          "timestamp": { "type": "number" },
          "recipient": { "type": "string", "minLength": 1 }
        }
      }
