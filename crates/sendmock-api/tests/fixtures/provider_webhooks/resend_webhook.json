{
  "doc_url": "https://resend.com/docs/dashboard/webhooks/event-types",
  "verified_on": "2026-11-05",
  "method": "POST",
  "content_type": "application/json",
  "documented_example": {
    "type": "email.delivered",
    "created_at": "2024-02-22T23:41:12.126Z",
    "data": {
      "created_at": "2024-02-22T23:41:11.894719+00:00",
      "email_id": "56761188-7520-42d8-8898-ff6fc54ce618",
      "from": "Acme <onboarding@resend.dev>",
      "to": ["delivered@resend.dev"],
      "subject": "Sending this example"
    }
  },
  "schema": {
    "type": "object",
    "required": ["type", "created_at", "data"],
    "properties": {
      "type": { "type": "string", "pattern": "^email\\.[a-z_]+$" },
      "created_at": { "type": "string", "minLength": 1 },
      "data": {
        "type": "object",
        "required": ["created_at", "email_id", "from", "to", "subject"],
        "properties": {
          "email_id": { "type": "string", "minLength": 1 },
          "from": { "type": "string", "minLength": 1 },
          "to": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "subject": { "type": "string" }
        }
      }
    }
  }
}
