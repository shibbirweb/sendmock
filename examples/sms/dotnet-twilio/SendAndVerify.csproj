<Project Sdk="Microsoft.NET.Sdk">
  <!-- The official Twilio C# SDK sending an SMS and running a Verify login against SendMock. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Twilio" Version="8.2.0" />
  </ItemGroup>
</Project>
